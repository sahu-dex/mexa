APP_ENV=production
APP_NAME="Mexa Motion"
APP_URL="https://your-domain.com"
APP_TIMEZONE="Asia/Dhaka"

# --- Database (choose ONE style) ---
# Style A: classic (cPanel / local)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your_cpanel_dbname
DB_USER=your_cpanel_dbuser
DB_PASS=your_strong_db_password
DB_CHARSET=utf8mb4

# Style B: Railway MySQL plugin (auto-injected when you add MySQL service)
# MYSQLHOST=maglev.proxy.rlwy.net  (or mysql.railway.internal for private network)
# MYSQLPORT=12345
# MYSQLDATABASE=railway
# MYSQLUSER=root
# MYSQLPASSWORD=xxxxxxxx

# Style C: single URL (Railway private/public URL)
# DATABASE_URL=mysql://root:password@host:port/railway
# MYSQL_URL=mysql://root:password@host:port/railway

MAIL_FROM="noreply@your-domain.com"
MAIL_FROM_NAME="Mexa Motion Website"
MAIL_TO="admin@your-domain.com"

ADMIN_SETUP_KEY="change-this-setup-key-before-first-run"

MAX_IMAGE_BYTES=5242880
MAX_VIDEO_BYTES=52428800

# Railway-only optional: auto-run seed on deploy
# RUN_MIGRATIONS=0
