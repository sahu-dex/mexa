# Production template. Copy to .env and replace every placeholder using cPanel values.
# Never commit .env or paste its values into code, logs, chat or GitHub.
# For local HTTP/XAMPP only, override APP_ENV=local, APP_DEBUG=true,
# APP_URL to your local URL, and SESSION_SECURE_COOKIE=false.

APP_NAME="Mexa Motion"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example

# Cloudflare / Tunnel / reverse-proxy preview only: use * when PHP is reachable
# exclusively through that proxy, or list proxy IPs/CIDRs separated by commas.
# Leave empty for direct Apache/cPanel hosting.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Dhaka

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=replace-with-cpanel-mysql-host
DB_PORT=3306
DB_DATABASE=replace-with-cpanel-db-name
DB_USERNAME=replace-with-cpanel-db-user
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# Set true on HTTPS production; set false only for local HTTP development.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=sync
# Admin uploads explicitly use the persistent "public" disk (storage/app/public/media).
# Keep the default local disk for private runtime files.
FILESYSTEM_DISK=local

# Legacy only; local website uploads do not require this key.
IMGBB_API_KEY=
