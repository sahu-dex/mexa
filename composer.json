{
  "name": "mexa-motion/website",
  "type": "project",
  "description": "Dynamic Laravel website for Mexa Motion",
  "keywords": ["laravel", "cms", "mexa-motion"],
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"]
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {"php-http/discovery": true}
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
