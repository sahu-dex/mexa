{
  // MEXA MOTION — Cloudflare Workers + SQLite Durable Object configuration.
  //
  // Deploys and runs 100% natively on Cloudflare Workers (both Free and Paid plans)
  // without requiring Cloudflare Containers (`containers` / `/containers/me` is
  // Paid-only and omitted so Workers Builds succeeds on every account):
  //   - Untouched Blade views (`resources/views/**/*.blade.php`) and public assets
  //     (`public/css/*`, `public/js/*`) are bundled directly via `rules`.
  //   - Dynamic pages, `/admin`, `/api/*`, sessions, media uploads, video library,
  //     bookings and reviews persist inside the SQLite-backed Durable Object
  //     `MexaContainer` (`ctx.storage.sql`).
  //   - Optional: set `ORIGIN_URL` secret/var to proxy to an external PHP origin.
  //
  // Docs: docs/CLOUDFLARE_DEPLOYMENT.md
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mexa",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-11-09",
  "workers_dev": true,
  "preview_urls": true,

  "observability": {
    "enabled": true
  },

  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.blade.php", "**/*.css", "*public/js/*.js"],
      "fallthrough": true
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "MEXA_APP",
        "class_name": "MexaContainer"
      }
    ]
  },

  "exports": {
    "MexaContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },

  // ---------------------------------------------------------------------------
  // Non-secret runtime settings.
  // ---------------------------------------------------------------------------
  "vars": {
    "APP_NAME": "Mexa Motion",
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "APP_TIMEZONE": "Asia/Dhaka",
    "APP_LOCALE": "en",
    "APP_FALLBACK_LOCALE": "en",

    "LOG_CHANNEL": "stderr",
    "LOG_LEVEL": "error",

    "DB_CONNECTION": "sqlite",
    "DB_PORT": "3306",
    "DB_CHARSET": "utf8mb4",
    "DB_COLLATION": "utf8mb4_unicode_ci",

    "SESSION_DRIVER": "database",
    "SESSION_TABLE": "sessions",
    "SESSION_LIFETIME": "120",
    "SESSION_ENCRYPT": "true",
    "SESSION_SECURE_COOKIE": "true",
    "SESSION_HTTP_ONLY": "true",
    "SESSION_SAME_SITE": "lax",

    "CACHE_STORE": "file",
    "QUEUE_CONNECTION": "sync",
    "FILESYSTEM_DISK": "local",

    "TRUSTED_PROXIES": "*",

    "MEXA_CONTAINER_PORT": "8080",
    "MEXA_INSTANCE_TYPE": "basic",
    "MEXA_INACTIVITY_TIMEOUT_MS": "300000"
  },

  // NOTE: no "limits" or "containers" blocks on purpose.
  // Both `limits.cpu_ms` (`code: 100328`) and Cloudflare Containers (`/containers/me`)
  // fail on the Workers Free plan. Running natively on Workers + SQLite Durable
  // Objects works on both Free and Paid plans with zero extra setup.

  // ---------------------------------------------------------------------------
  // Worker Previews (`npx wrangler preview`, used by Cloudflare for non-production
  // branches / pull requests).
  // ---------------------------------------------------------------------------
  "previews": {
    "durable_objects": {
      "bindings": [
        {
          "name": "MEXA_APP",
          "class_name": "MexaContainer"
        }
      ]
    },

    "vars": {
      "APP_NAME": "Mexa Motion (Preview)",
      "APP_ENV": "production",
      "APP_DEBUG": "false",
      "APP_TIMEZONE": "Asia/Dhaka",
      "APP_LOCALE": "en",
      "APP_FALLBACK_LOCALE": "en",

      "LOG_CHANNEL": "stderr",
      "LOG_LEVEL": "debug",

      "DB_CONNECTION": "sqlite",
      "DB_PORT": "3306",
      "DB_CHARSET": "utf8mb4",
      "DB_COLLATION": "utf8mb4_unicode_ci",

      "SESSION_DRIVER": "database",
      "SESSION_TABLE": "sessions",
      "SESSION_LIFETIME": "120",
      "SESSION_ENCRYPT": "true",
      "SESSION_SECURE_COOKIE": "true",
      "SESSION_HTTP_ONLY": "true",
      "SESSION_SAME_SITE": "lax",

      "CACHE_STORE": "file",
      "QUEUE_CONNECTION": "sync",
      "FILESYSTEM_DISK": "local",

      "TRUSTED_PROXIES": "*",

      "MEXA_CONTAINER_PORT": "8080",
      "MEXA_INSTANCE_TYPE": "basic",
      "MEXA_INACTIVITY_TIMEOUT_MS": "60000"
    }
  }
}
