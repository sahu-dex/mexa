# Isolated preview template. Copy to .env, replace APP_URL and generate APP_KEY.
# Never commit .env, the SQLite database, uploaded media, or backups.

APP_NAME="Mexa Motion"
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=https://your-preview-domain.example
TRUSTED_PROXIES=*

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Omit DB_DATABASE to use database/database.sqlite inside the checkout.
DB_FOREIGN_KEYS=true

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Legacy only; the website's own storage does not require this key.
IMGBB_API_KEY=
