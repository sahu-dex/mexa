# ---------------------------------------------------------------------------
# Cloudflare Workers env template (secrets only).
#
# `wrangler.jsonc` already holds the non-secret vars. Anything below that is
# filled in is uploaded as a Worker secret and forwarded to the Laravel
# container at start-up:
#
#   cp .env.cloudflare.example .dev.vars      # local fill-in copy (git-ignored)
#   npx wrangler secret bulk .dev.vars        # upload to Cloudflare
#
# Never commit the filled-in copy, and never paste these values into code,
# logs, chat or GitHub.
# ---------------------------------------------------------------------------

# Required: 32-byte key from `php artisan key:generate --show` (starts with base64:).
APP_KEY=

# Optional. Leave empty to keep request-derived URLs, or set your real HTTPS
# domain, e.g. https://mexa-motion.com (no trailing slash).
APP_URL=

# Required for the public website, admin dashboard and media library.
# Use the MySQL/MariaDB host that accepts remote connections.
DB_HOST=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# Optional: absolute path to a CA bundle inside the container when the database
# provider requires TLS verification.
MYSQL_ATTR_SSL_CA=

# Optional: persistent media storage in Cloudflare R2 (recommended, because the
# container disk is ephemeral). Create the bucket in the dashboard first, then
# create an R2 API token with Object Read & Write for that bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional: legacy ImgBB integration; the website's own media library does not
# need it.
IMGBB_API_KEY=
