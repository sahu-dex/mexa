APP_ENV=production
APP_NAME="Mexa Motion"
APP_URL="https://your-domain.com"
APP_TIMEZONE="Asia/Dhaka"

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your_cpanel_dbname
DB_USER=your_cpanel_dbuser
DB_PASS=your_strong_db_password
DB_CHARSET=utf8mb4

