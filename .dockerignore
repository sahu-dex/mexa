# Never bake secrets or local runtime state into the container image.
.env
.env.*
!.env.example
!.env.cloudflare.example
.dev.vars
.dev.vars.*
/.wrangler/

# Native PHP/Composer deps and Node tooling (built/copied at image build time).
/node_modules
/scripts/preview/node_modules/
/vendor/

# Local database, uploads, logs and caches.
/database/*.sqlite
/database/*.sqlite3
/storage/app/public/media/*
/storage/app/private/*
/storage/logs/*
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/bootstrap/cache/*.php
